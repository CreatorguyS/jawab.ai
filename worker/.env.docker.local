# =============================================================================
# worker/.env.docker — Environment for Docker deployment
# =============================================================================
# ⚠ Fill in real values. NEVER commit this file to version control.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=5001

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_WHITELIST=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Internal service URLs — Docker DNS ───────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8000
RAG_SERVICE_URL=http://rag:8001

# ── MongoDB Atlas (cloud) ────────────────────────────────────────────────────
MONGODB_URI=mongodb://mongodb:27017/replypilot

# ── Redis Cloud (cloud) ──────────────────────────────────────────────────────
REDIS_URL=redis://:dummy@redis:6379
REDIS_PORT=6379
#REDIS_USERNAME=
#REDIS_PASSWORD=
REDIS_BULL_PREFIX=bull

# ── Secrets ───────────────────────────────────────────────────────────────────
SESSION_SECRET=your_session_secret_min_32_chars

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key

REDIS_PASSWORD=dummy
